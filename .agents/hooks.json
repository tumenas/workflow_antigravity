{
  "workspace-guardrails": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python ./hooks/workspace-guardrails.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "session-checkin": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python ./hooks/session-checkin.py",
        "timeout": 5
      }
    ]
  },
  "session-logger": {
    "Stop": [
      {
        "type": "command",
        "command": "python ./hooks/session-logger.py",
        "timeout": 10
      }
    ]
  }
}
