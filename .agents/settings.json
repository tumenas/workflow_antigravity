{
  "project": {
    "name": "Research Compendium",
    "language": "pt-BR",
    "stack": ["python", "r", "quarto"],
    "manuscriptPath": "manuscript/manuscript.qmd",
    "dataRawPath": "data/raw",
    "dataProcessedPath": "data/processed",
    "resultsPath": "results",
    "qualityReportsPath": "quality_reports",
    "orchestrator": "run.ps1"
  },
  "qualityThresholds": {
    "commit": 80,
    "share": 90,
    "submit": 95
  },
  "rules": {
    "directory": ".agents/rules",
    "alwaysLoad": [
      "meta-governance.md",
      "quality-gates.md",
      "verification-protocol.md"
    ],
    "loadOnDemand": [
      "cross-artifact-review.md",
      "post-flight-verification.md",
      "proofreading-protocol.md",
      "r-code-conventions.md"
    ]
  },
  "skills": {
    "directory": ".agents/skills"
  },
  "memory": {
    "file": ".agents/MEMORY.md",
    "maxLinesLoaded": 200
  },
  "plansDirectory": "quality_reports/plans",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Edit(**)",
      "Write(**)",
      "MultiEdit(**)",
      "Bash(*)",
      "WebFetch(*)",
      "WebSearch",
      "Read(**)"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.agents/hooks/git-guardrails.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.agents/hooks/pre-compact.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.agents/hooks/post-compact-restore.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.agents/hooks/context-monitor.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.agents/hooks/claim-reconcile.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.agents/hooks/log-reminder.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR\"/.agents/scripts/statusline.sh"
  }
}
